/* Exact photo-inspired auth + brand skin; existing product functionality remains unchanged. */
:root{--bg:#fff7f1;--surface:#fffaf6;--ink:#3b2418;--muted:#9a8b81;--line:#eadfd6;--accent:#f47716;--accent-dark:#b94d08;--dark:#fff0e5}
html,body{background:#111;color:var(--ink)}
.app{background:var(--bg);max-width:560px}
.topbar{background:var(--bg);color:var(--ink);border-bottom:1px solid #f2e5dc}
.header-brand img{background:#fff0e5;border-radius:12px}
.header-brand span{color:var(--ink)!important}
.header-brand span span{color:var(--accent)}
.icon-btn,.cart-icon{background:#fff;border:1px solid var(--line);color:var(--ink)}
.location,.address-picker{background:var(--bg);color:var(--ink)}
.location{color:var(--ink)}
.search{background:#fff;border-color:#eee1d7}
.ai-banner{background:#ffe6d2;color:var(--ink)}
.ai-bot{background:var(--accent);color:#fff}
.cats button,.chips button,.chip{background:#fff;border-color:var(--line);color:var(--ink)}
.cats button:first-child,.chips button.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.link{color:var(--accent-dark)}
.restaurant-img,.food-img,.detail-hero,.menu-product-img,.mini-img{background:#fff0e5;color:var(--accent)}
.plus,.primary{background:var(--accent);color:#fff}
.summary,.profile-card{background:#fff0e5;color:var(--ink)}
.avatar{background:var(--accent);color:#fff}
.bottom-nav{background:rgba(255,250,246,.97);border-top-color:var(--line)}
.nav-item.active,.bottom-nav button.active{color:var(--accent)}
.qty{background:#fff0e5}
.bubble.bot{background:#fff0e5}.bubble.user{background:var(--accent);color:#fff}
.chat-input{background:var(--bg)}
.chat-input input,.checkout input,.checkout textarea{background:#fff;border-color:var(--line)}
